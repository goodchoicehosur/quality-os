# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local install:  mongodb://127.0.0.1:27017/quality-os
# Atlas example:  mongodb+srv://<user>:<password>@cluster0.mongodb.net/quality-os
MONGO_URI=mongodb://127.0.0.1:27017/quality-os

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=8h

# CORS - the URL your frontend runs on
CLIENT_URL=http://localhost:3000

# Seed / default admin (used only by `npm run seed`)
SEED_ADMIN_EMAIL=admin@qualityos.local
SEED_ADMIN_PASSWORD=Admin@12345
